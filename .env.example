# =============================================
# SLENDER HUB — Environment Variables
# =============================================
# Copie este arquivo para .env.local e preencha os valores

# --- SUPABASE ---
# URL do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Anon key (pública, usada no frontend — pegue no dashboard do Supabase)
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
# Service Role Key (SECRETA — usada apenas no backend, NUNCA no frontend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui

# --- STRIPE ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PAYMENT (PIX) ---
VITE_PIX_KEY=sua-chave-pix-aqui

# --- SMTP / EMAIL ---
SMTP_EMAIL=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-do-gmail
ADMIN_EMAIL=admin@seudominio.com

# --- SCRIPT PROTECTION ---
# Gere uma chave aleatória de 64 caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCRIPT_HMAC_SECRET=coloque-uma-chave-aleatoria-de-64-caracteres-aqui

# --- GEMINI (opcional) ---
GEMINI_API_KEY=sua-chave-gemini-aqui
