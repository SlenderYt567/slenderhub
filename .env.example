# =============================================
# ZW STORE — Environment Variables
# =============================================
# Copie este arquivo para .env.local e preencha os valores

# --- SUPABASE ---
# URL do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Anon key (pública, usada no frontend — pegue no dashboard do Supabase)
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
# Service Role Key (SECRETA — usada apenas no backend, NUNCA no frontend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui

# --- STRIPE ---
# Checkout hospedado: não precisa de chave pública no navegador.
# Comece com uma chave restrita (rk_test_...) de um sandbox separado.
VITE_STRIPE_ENABLED=false
STRIPE_ENABLED=false
SITE_URL=https://www.zwhub.store
STRIPE_SECRET_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PAYMENT (PIX) ---
VITE_PIX_KEY=sua-chave-pix-aqui

# --- PAYMENT (CRYPTO / Trust Wallet) ---
# Endereços da carteira por rede (USDT usa a rede ERC-20 / Ethereum — endereço 0x)
VITE_CRYPTO_ADDRESS_USDT=seu-endereco-usdt-erc20
VITE_CRYPTO_ADDRESS_LTC=seu-endereco-litecoin
VITE_CRYPTO_ADDRESS_SOL=seu-endereco-solana

# --- SMTP / EMAIL ---
SMTP_EMAIL=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-do-gmail
ADMIN_EMAIL=admin@seudominio.com

# --- SCRIPT PROTECTION ---
# Gere uma chave aleatória de 64 caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCRIPT_HMAC_SECRET=coloque-uma-chave-aleatoria-de-64-caracteres-aqui

# --- GEMINI (opcional) ---
GEMINI_API_KEY=sua-chave-gemini-aqui
